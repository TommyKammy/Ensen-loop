{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensen-loop.local/schemas/local-work-item.schema.json",
  "title": "Ensen-loop Phase 1 Local Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "source", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Stable local work item identifier."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Human-readable work item title containing at least one non-whitespace character."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Local source label containing at least one non-whitespace character."
    },
    "status": {
      "type": "string",
      "enum": ["ready", "blocked", "running", "completed", "failed"],
      "description": "Local lifecycle status understood by Phase 1 dry-run planning."
    }
  }
}
